# Tarayıcıda site kökü (e-posta doğrulama: …/auth/callback). Sonunda / olmasın.
# NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase proje kök URL’i (Dashboard → Project Settings → API → Project URL)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co

# Aşağıdakilerden BİRİNİ kullanın (ikisini birden zorunlu değil):
# — Eski panel: "anon" "public" API key
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# — Yeni panel: Publishable key (sb_publishable_... veya benzeri)
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Sunucu tarafında RLS’yi bypass eden işler (kayıt senkronu, süperadmin) — asla NEXT_PUBLIC yapmayın, Git’e koymayın
# Şema: supabase/migrations/ içindeki tenants migration’ını Supabase SQL Editor’da çalıştırın.
# Authentication → URL Configuration → Redirect URLs: ${NEXT_PUBLIC_SITE_URL}/auth/callback
# SUPABASE_SERVICE_ROLE_KEY=

# Süperadmin (/superadmin) — Git’e koymayın
# SUPERADMIN_PASSWORD=
# En az 16 karakter rastgele dize (oturum çerezi imzası)
# SUPERADMIN_SESSION_SECRET=

# Patron admin (/dashboard/admin) PIN oturumu için en az 16 karakter rastgele dize
# OWNER_ADMIN_SESSION_SECRET=

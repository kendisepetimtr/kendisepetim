# Tarayıcıda site kökü (e-posta doğrulama: …/auth/callback). Sonunda / olmasın.
# Canli site kok adresi — Supabase Site URL yanlis localhost ise OAuth hatalari buraya tasinir.
# Vercel Production'da zorunlu: https://kendisepetim.com
NEXT_PUBLIC_CANONICAL_SITE_URL=https://kendisepetim.com

# Yerel gelistirme icin localhost; Vercel Production'da https://kendisepetim.com
# NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase proje kök URL'i (Dashboard → Project Settings → API → Project URL)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co

# Asagidakilerden BIRINI kullanin (ikisini birden zorunlu degil):
# — Eski panel: "anon" "public" API key
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# — Yeni panel: Publishable key (sb_publishable_... veya benzeri)
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Sunucu tarafinda RLS'yi bypass eden isler — asla NEXT_PUBLIC yapmayin, Git'e koymayin
# SUPABASE_SERVICE_ROLE_KEY=

# Supabase kurulumu (canli):
# 1. supabase/migrations/ dosyalarini SQL Editor'da sirayla calistirin
# 2. Storage: "menu-images" bucket (public read)
# 3. Authentication → URL Configuration
#    Site URL: https://kendisepetim.com
#    Redirect URLs:
#      https://kendisepetim.com/auth/callback
#      https://www.kendisepetim.com/auth/callback
#      http://localhost:3000/auth/callback
#
#    Giris akisi (uygulama):
#      E-posta/sifre  → /giris → /dashboard
#      Google         → /auth/callback?next=/dashboard → /dashboard
#      E-posta onay   → /auth/callback?next=/giris?verified=1
#      Sifre sifirla  → /auth/callback?next=/sifre-yenile
# 5. Google OAuth:
#    Supabase → Authentication → Providers → Google (Client ID + Secret)
#    Google Cloud Console → OAuth client → Authorized redirect URI:
#      https://mjfrwzgvjkodkobcslxf.supabase.co/auth/v1/callback
#    (Supabase proje URL'iniz farkliysa onu kullanin)
# 4. Custom SMTP (Resend vb.) — gercek e-posta icin zorunlu
#
# Vercel (Production environment):
# - Root Directory: kendisepetim (repo kokunden deploy ediyorsaniz)
# - Domainler: kendisepetim.com, www.kendisepetim.com, *.kendisepetim.com
# - Cloudflare DNS: @, www ve * kayitlarini Vercel'e yonlendirin

# Superadmin (/superadmin) — Git'e koymayin
# SUPERADMIN_PASSWORD=
# En az 16 karakter rastgele dize (oturum cerezi imzasi)
# SUPERADMIN_SESSION_SECRET=

# Patron admin (/dashboard/admin) PIN oturumu icin en az 16 karakter rastgele dize
# OWNER_ADMIN_SESSION_SECRET=
